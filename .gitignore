# ---------------------------------------------------------------------------
# Copyrighted Apple IIgs system ROM -- NEVER commit these to a public repo.
# Users supply their own ROM dump; see roms/Makefile for how it is built.
# NOTE: rtl/roms/*.hex ARE tracked -- the RTL $readmemh's them at elaboration
# and the core will not build without them. chr.mem is NOT tracked; it is
# generated by `make` in roms/ (see below).
# ---------------------------------------------------------------------------
/roms/*
!/roms/Makefile
*.rom
vsim/rom1/
vsim/rom3/

# chr.mem is generated by `make` in roms/ (from gen_chr.py). Not committed.
/chr.mem
vsim/chr.mem

# ---------------------------------------------------------------------------
# Disk images -- commercial software, do not redistribute.
# ---------------------------------------------------------------------------
*.hdv
*.woz
*.2mg
*.po
*.dsk
*.nib
*.zip
disks_35_apple2/
disks_35_iigs/
disks_525/

# ---------------------------------------------------------------------------
# customtests/: keep the .S sources + Makefile, drop the built artifacts and
# the vendored third-party toolchains (CiderPress2 ships a 78MB .NET runtime;
# Merlin32 ships prebuilt binaries). Both should be downloaded, not committed.
# ---------------------------------------------------------------------------
customtests/*.SYSTEM
customtests/*_Output.txt
customtests/*_Symbols.txt
customtests/*_FileInformation.txt
customtests/cp2_*/
customtests/Merlin32_*/
customtests/floppy_rw_*.woz

# blank.2mg is the bootable ProDOS template every test disk is built from -- it
# is a build INPUT, not an artifact, so it must survive the *.2mg rule above.
!customtests/blank.2mg

# ---------------------------------------------------------------------------
# vsim/: allowlist. The working dir accumulates GBs of logs, memory dumps,
# screenshots and disk images, so ignore everything by default and opt the
# sources back in. Add new tracked files here explicitly.
# ---------------------------------------------------------------------------
vsim/*
!vsim/Makefile
!vsim/sim.v
!vsim/sim_main.cpp
!vsim/mmu_tb.cpp
!vsim/sim/
!vsim/rtl/
!vsim/sdram_tb/
!vsim/sdram_accel/
!vsim/regression_images/
!vsim/regression.sh
!vsim/selftest.sh
!vsim/verilate.sh
!vsim/test_woz_batch.sh
!vsim/woz_review.sh
!vsim/gen_chr.py
!vsim/woz_classify_platform.py
!vsim/woz_detect_13sector.py
!vsim/dhr_validate.py

# ...but the ignores above still apply inside the allowlisted dirs
vsim/sdram_tb/*.vvp

# Local Quartus output copied to the repo root (releases/*.rbf stay tracked)
/*.rbf
