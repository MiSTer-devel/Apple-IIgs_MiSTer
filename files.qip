# Quartus source list for the Apple IIgs core.
#
# NOTE: rtl/bram.sv is intentionally NOT listed here. The `bram` module is
# supplied to the FPGA build by rtl/dpram_bram.vhd (altsyncram); bram.sv is the
# Verilator-only equivalent and is listed in vsim/Makefile instead.
#
# NOTE: rtl/sdram.sv is not listed either -- the core instantiates sdram_burst.
# sdram.sv survives only as a reference for the vsim/sdram_tb testbenches.

# --- CPU ---
set_global_assignment -name QIP_FILE rtl/65C816/65C816.qip

# --- System / memory ---
set_global_assignment -name SYSTEMVERILOG_FILE rtl/iigs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/mmu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/dpram.sv
set_global_assignment -name VHDL_FILE rtl/dpram_bram.vhd
set_global_assignment -name VERILOG_FILE rtl/rom.v
set_global_assignment -name VERILOG_FILE rtl/syncram.v

# --- SDRAM / accelerator ---
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram_burst.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/zipgs_regs.sv
set_global_assignment -name VERILOG_FILE rtl/ddr_trace.v

# --- TransWarp GS card ---
set_global_assignment -name SYSTEMVERILOG_FILE rtl/twgs_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/twgs_nvram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/twgs_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/twgs_card.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/uthernet2.sv

# --- Video ---
set_global_assignment -name SYSTEMVERILOG_FILE rtl/vgc.v
set_global_assignment -name VERILOG_FILE rtl/video_timing.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video_geom.sv

# --- Sound ---
set_global_assignment -name VERILOG_FILE rtl/sound.v
set_global_assignment -name VERILOG_FILE rtl/soundglu.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/es5503.v

# --- Input / RTC ---
set_global_assignment -name SYSTEMVERILOG_FILE rtl/adb.v
set_global_assignment -name VERILOG_FILE rtl/prtc.v
set_global_assignment -name VERILOG_FILE rtl/paddle_timer.v

# --- Disk (IWM / WOZ / SmartPort / HDD) ---
set_global_assignment -name SYSTEMVERILOG_FILE rtl/iwm_woz.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/iwm_flux.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/woz_floppy_controller.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/flux_drive.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/smartport_dev.v
set_global_assignment -name VERILOG_FILE rtl/hdd.v

# --- Serial ---
set_global_assignment -name VERILOG_FILE rtl/scc_iigs_wrapper.v
set_global_assignment -name VERILOG_FILE rtl/scc8530.v
set_global_assignment -name VERILOG_FILE rtl/uart/rxuart.v
set_global_assignment -name VERILOG_FILE rtl/uart/txuart.v

# --- Clocking ---
set_global_assignment -name VERILOG_FILE rtl/clock_divider.v

# --- Top level ---
set_global_assignment -name SYSTEMVERILOG_FILE Apple-IIgs.sv
